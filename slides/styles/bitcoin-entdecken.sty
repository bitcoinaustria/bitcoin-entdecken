\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{bitcoin-entdecken}[2025/08/11 Bitcoin Entdecken Presentation Style]

%% Required packages
\RequirePackage[utf8]{inputenc}
\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\RequirePackage{amsmath}
\RequirePackage{amsfonts}
\RequirePackage{booktabs}
\RequirePackage[protrusion=true,expansion=false]{microtype}

%% TikZ libraries
\usetikzlibrary{calc}

%% Bitcoin Color Definitions
\definecolor{bitcoinorange}{RGB}{247,147,26}
\definecolor{bitcoindark}{RGB}{33,33,33}
\definecolor{bitcoinlight}{RGB}{255,255,255}

%% Theme Setup - Metropolis with Bitcoin customizations
% Note: User must load metropolis theme before this package
% \usetheme[progressbar=foot]{metropolis}

%% Color Theme Customizations
\setbeamercolor{background canvas}{bg=white}
\setbeamercolor{normal text}{bg=white}
\setbeamercolor{progress bar}{fg=bitcoinorange, bg=bitcoindark!50}
\setbeamercolor{palette primary}{bg=bitcoinorange,fg=white}
\setbeamercolor{palette secondary}{bg=bitcoindark,fg=white}
\setbeamercolor{structure}{fg=bitcoinorange}
\setbeamercolor{frametitle}{bg=bitcoinorange,fg=white}
\setbeamercolor{title}{bg=bitcoindark,fg=bitcoindark}
\setbeamercolor{block title}{bg=bitcoinorange,fg=white}
\setbeamercolor{block body}{bg=bitcoinorange!10}
\setbeamercolor{frame footer}{bg=bitcoinorange!10}
\setbeamercolor{date in head/foot}{bg=bitcoinorange, fg=bitcoinlight}

%% Font Customizations
\setbeamerfont{footnote}{size=\tiny}
\renewcommand{\thefootnote}{\arabic{footnote}}
\renewcommand{\thempfootnote}{\arabic{mpfootnote}}

% Ensure footnote markers are always numeric even in templates
\setbeamertemplate{footnote}{%
  \parindent 1em\noindent
  \raggedright
  \hbox to 1.8em{\hfil\insertfootnotemark}\insertfootnotetext\par
}
\setbeamertemplate{footnote reference}{\insertfootnotemark}

%% Custom Footer with frame numbers only
\setbeamertemplate{footline}{%
    \leavevmode%
    \hbox{%
        \begin{beamercolorbox}[wd=\paperwidth,ht=2.25ex,dp=1ex,right]{date in head/foot}%
            \insertframenumber{} / \inserttotalframenumber\hspace*{2ex}
        \end{beamercolorbox}%
    }
    \vskip0pt%
}

%% Remove margins from beamer frames
\setbeamersize{text margin left=5pt,text margin right=5pt}

%% Custom Frame Title Template with Bitcoin Entdecken logo
\setbeamertemplate{frametitle}{%
    \nointerlineskip%
    \begin{beamercolorbox}[wd=\paperwidth,ht=2.6ex,dp=1ex,leftskip=0pt,rightskip=0pt]{frametitle}
        \hbox to \paperwidth{%
            \begin{beamercolorbox}[wd=0.75\paperwidth,left]{frametitle}%
                \hspace*{3pt}\usebeamerfont{frametitle}\insertframetitle%
            \end{beamercolorbox}%
            \begin{beamercolorbox}[wd=0.25\paperwidth,right]{frametitle}%
                \hfill\raisebox{-1ex}{\includegraphics[height=3.8ex,keepaspectratio]{../logo-bitcoin-entdecken.pdf}}\hspace*{1pt}%
            \end{beamercolorbox}%
        }
    \end{beamercolorbox}
}

%% Macro: Rounded corner images with aspect ratio support
\newcommand{\roundedimage}[3]{%
    % #1: image path
    % #2: width (e.g., 0.4\textwidth)
    % #3: aspect ratio (2 for 2:1, 1 for 1:1)
    \begin{tikzpicture}
        \ifnum#3=2
            % 2:1 aspect ratio with extra height to avoid clipping heads (width:height ratio ~1.8:1)
            \clip[rounded corners=5pt] (0,0) rectangle (#2,0.56*#2);
        \else
            % 1:1 aspect ratio (default)
            \clip[rounded corners=5pt] (0,0) rectangle (#2,#2);
        \fi
        \node[anchor=south west, inner sep=0pt] at (0,0) {\includegraphics[width=#2,keepaspectratio]{#1}};
    \end{tikzpicture}
}

%% Misconception Counter
\newcounter{mvnum}
\setcounter{mvnum}{0}

%% Macro: Misconception slides with consistent layout
\newcommand{\misconceptionslide}[5][]{%
    % #1: Optional image path (if provided, image shows on first slide where facts appear later)
    % #2: Frame title (e.g., "Umweltauswirkungen")
    % #3: Misconception text (in quotes)
    % #4: Facts list items
    % #5: Fazit text
    \stepcounter{mvnum}
    \subsection{\arabic{mvnum}. #2}
    \begin{frame}<1-2>{M\arabic{mvnum}: #2}
        % Fußnoten pro Folie neu ab 1 zählen -- sonst laufen die \footnotemark-Ziffern
        % global weiter, während \footnotetext[1..n] pro Folie bei 1 beginnt.
        \setcounter{footnote}{0}
        \begin{columns}[T]
            \begin{column}[T]{0.49\textwidth}
                \begin{block}{Das Missverständnis}
                    \vspace{0.6em}
                    \textit{\textbf{``#3''}}
                    \vspace{0.6em}
                \end{block}
            \end{column}
            \hspace{0.01\textwidth}
            \begin{column}[T]{0.49\textwidth}
                % Optional image only visible on first slide (where facts will appear later)
                \ifx\relax#1\relax
                    % No image provided
                \else
                    \only<1>{
                        \vspace{1em}
                        \centering
                        \roundedimage{#1}{0.9\textwidth}{1}
                        \vspace{1em}
                    }
                \fi
                \onslide<2->{
                    \begin{block}{Die Fakten}
                        \vspace{0.3em}
                        \begin{itemize}
                            \setlength{\itemsep}{0.3em}
                            #4
                        \end{itemize}
                        \vspace{0.3em}
                    \end{block}
                }
            \end{column}
        \end{columns}
        
        \vfill
        
        \onslide<2->{
            \begin{alertblock}{\textcolor{white}{\textbf{Fazit:}}}
                % \small nur hier: das Fazit muss auch bei vollen Faktenlisten in den Rahmen passen
                \small #5
            \end{alertblock}
        }
    \end{frame}
}

%% Title Setup Helpers
% These commands help set up consistent title slides
\newcommand{\bitcointitle}[2]{%
    % #1: Main title
    % #2: Subtitle
    \title[#1]{\vspace{1.5in}#1}
    \subtitle{#2}
    \author{Bitcoin Entdecken / Bitcoin Austria}
    \date{\today}
    \institute{}
}

\newcommand{\bitcointitlegraphic}[1]{%
    % #1: Image path for title graphic
    \titlegraphic{\center\vspace{-1.5em}\roundedimage{#1}{0.5\textwidth}{2}}
}

%% Myth Counter (for Mythen presentation)
\newcounter{mythennum}
\setcounter{mythennum}{0}

%% Pro block color (darker, represents "myth believer" side)
\setbeamercolor{block title problock}{bg=bitcoindark!65,fg=white}
\setbeamercolor{block body problock}{bg=bitcoindark!12}

%% Macro: Myth slides with 3-overlay layout
%% Overlay 1: Description + Image | Overlay 2: Pro + Contra side by side | Overlay 3: Fazit + Probability + Sources
\newcommand{\mythslide}[8][]{%
    % #1: Optional image path (1:1, shown on overlay 1)
    % #2: Short title
    % #3: Myth description text
    % #4: Pro items (\item ... why the myth seems plausible)
    % #5: Contra items (\item ... facts that debunk it)
    % #6: Conclusion text
    % #7: Probability text (e.g., "$\sim$15\%")
    % #8: Source items (\item \href{url}{text} ...)
    \stepcounter{mythennum}
    \subsection{\arabic{mythennum}. #2}
    \begin{frame}<1-3>{Mythos \arabic{mythennum}: #2}
        % Overlay 1: Description + Image
        \only<1>{%
            \ifx\relax#1\relax
                % No image: full-width description
                \begin{block}{Der Mythos}
                    \vspace{0.4em}
                    #3
                    \vspace{0.4em}
                \end{block}
            \else
                % With image: two-column layout, top-aligned
                \begin{columns}[T]
                    \begin{column}{0.45\textwidth}
                        \begin{block}{Der Mythos}
                            \vspace{0.4em}
                            \small #3
                            \vspace{0.4em}
                        \end{block}
                    \end{column}
                    \hspace{0.01\textwidth}
                    \begin{column}{0.52\textwidth}
                        \centering
                        \begin{tikzpicture}
                            \node[inner sep=0pt, rounded corners=5pt, clip] {%
                                \includegraphics[width=\textwidth,height=0.85\textheight,keepaspectratio]{#1}%
                            };
                        \end{tikzpicture}
                    \end{column}
                \end{columns}
            \fi
        }%
        % Overlay 2: Pro (orange) + Contra (dark) side by side
        \only<2>{%
            \begin{columns}[T]
                \begin{column}[T]{0.49\textwidth}
                    \begin{block}{\textbf{Dafür spricht \ldots}}
                        \vspace{0.2em}
                        \begin{itemize}
                            \setlength{\itemsep}{0.3em}
                            #4
                        \end{itemize}
                        \vspace{0.2em}
                    \end{block}
                \end{column}
                \hspace{0.01\textwidth}
                \begin{column}[T]{0.49\textwidth}
                    \begingroup
                        \setbeamercolor{block title}{bg=bitcoindark!65,fg=white}
                        \setbeamercolor{block body}{bg=bitcoindark!12}
                        \begin{block}{\textbf{Dagegen spricht \ldots}}
                            \vspace{0.2em}
                            \begin{itemize}
                                \setlength{\itemsep}{0.3em}
                                #5
                            \end{itemize}
                            \vspace{0.2em}
                        \end{block}
                    \endgroup
                \end{column}
            \end{columns}
        }%
        % Overlay 3: Conclusion + centered probability + sources
        \only<3>{%
            \begin{alertblock}{\textcolor{white}{\textbf{Schlussfolgerung}}}
                #6
            \end{alertblock}
            \vspace{0.3em}
            \begin{center}
                \colorbox{bitcoinorange!15}{%
                    \hspace{1em}\textbf{\large Geschätzte Wahrscheinlichkeit: #7}\hspace{1em}%
                }
            \end{center}
            \vspace{0.3em}
            {\footnotesize
            \textbf{Quellen:}
            \begin{itemize}
                \setlength{\itemsep}{0.1em}
                #8
            \end{itemize}
            }
        }%
    \end{frame}
}

